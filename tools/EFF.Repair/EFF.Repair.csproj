<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Nullable>annotations</Nullable>
    <DefineConstants>$(DefineConstants);EFF_SOURCE_READER</DefineConstants>
    <NativeCompilerPath Condition="'$(NativeCompilerPath)' == ''">$(MSBuildThisFileDirectory)../Blender/nativepack/eff_resource_pack.exe</NativeCompilerPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AnimeStudio/AnimeStudio.GUI/EndfieldVfsArchive.cs" Link="Sources/EndfieldVfsArchive.cs" />
    <Compile Include="../AnimeStudio/AnimeStudio.GUI/EndfieldIndexWorkspace.cs" Link="Sources/EndfieldIndexWorkspace.cs" />
    <Compile Include="../AnimeStudio/AnimeStudio.GUI/EndfieldPortableIndex.cs" Link="Sources/EndfieldPortableIndex.cs" />
    <Compile Include="../AnimeStudio/AnimeStudio.GUI/EndfieldBundleIndexCache.cs" Link="Sources/EndfieldBundleIndexCache.cs" />
    <Compile Include="../AnimeStudio/AnimeStudio.GUI/EndfieldIndexStore.cs" Link="Sources/EndfieldIndexStore.cs" />
    <Compile Include="../AnimeStudio/AnimeStudio.GUI/EndfieldBundleDependencyIndex.cs" Link="Sources/EndfieldBundleDependencyIndex.cs" />
    <Compile Include="../AnimeStudio/AnimeStudio.GUI/VirtualAssetPathIndex.cs" Link="Sources/VirtualAssetPathIndex.cs" />
    <Content Include="$(NativeCompilerPath)" Link="native/eff_resource_pack.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD_PARTY_NOTICES" Link="THIRD_PARTY_NOTICES" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireNativeCompiler" BeforeTargets="Build">
    <Error Condition="!Exists('$(NativeCompilerPath)')" Text="Build the paired offline compiler and set NativeCompilerPath before packaging EFF Repair." />
  </Target>
</Project>
