# Blender and test runs export real resource packages here. They are local
# fixtures/probes, not source-controlled assets.
/_blender_*/
/_test_output/
/release/

# Pre-deploy plugin binaries kept for quick rollback. These are build outputs,
# not sources; the corresponding releases live outside the repository.
/backups/

# Accidental PowerShell/native DLL staging directory.
/System.Management.Automation.Internal.Host.InternalHost/
/workspace-cleanup-20261025/

# Local game captures, compiled packages and profiling output (not source).
/diagnostics/

# AnimeStudio keeps its own source-control history.

!deps/**/*.lib
!deps/**/*.dll
!deps/**/*.pdb
