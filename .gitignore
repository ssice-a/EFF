/analysis/
/.vscode/
/_external_*/
/Maps/
/tmp_*
/_tmp-*/
/%SystemDrive%/
/tools/_inspect_skel.py
/tools/_blender_split_cache/
/tools/analyze_native_*.py
/tools/build_native_*.bat
/tools/build_vulkan_*.bat
/tools/build_pfb_*_trace.bat
/tools/build_upstream_mesh_boundary.bat
