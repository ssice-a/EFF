<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LibraryRoot Condition="'$(LibraryRoot)' == ''">$(MSBuildThisFileDirectory)../../tools/AnimeStudio/dist/win-x64-eff-package-v4</LibraryRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AnimeStudio">
      <HintPath>$(LibraryRoot)/AnimeStudio.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
